{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "instructions": ["AGENTS.md"],
  "mcp": {
    "handoff-package": {
      "type": "local",
      "command": ["npx", "tsx", ".opencode/tools/handoff-package/server.ts"]
    }
  },
  "tools": { "handoff-package": true },
  "watcher": { "ignore": ["**/node_modules/**", "**/dist/**", "**/build/**", "**/.git/**"] },
  "permission": {
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    "websearch": "allow",
    "webfetch": "allow",
    "question": "allow",
    "write": "ask",
    "edit": {
      "*": "ask",
      "packages/core/src/interfaces.ts": "deny",
      ".opencode/skill/constraints/**": "deny",
      ".opencode/skill/security/**": "deny",
      ".opencode/skill/principles/**": "deny",
      ".opencode/agent/*.md": "deny",
      "DECISION-LOG.md": "ask"
    },
    "bash": {
      "*": "ask",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push +*": "deny",
      "git push *--force*": "deny",
      "git reset --hard*": "deny",
      "npm publish*": "deny",
      "pnpm publish*": "deny",
      "pnpm changeset publish*": "deny",
      "yarn publish*": "deny",
      "npx changeset publish*": "deny",
      "rm -rf *": "deny",
      "kill -9 *": "deny",
      "kill *": "deny",
      "pkill*": "deny",
      "killall*": "deny",
      "pm2 *": "deny",
      "systemctl *": "deny",
      "gh workflow run*": "deny",
      "gh run*": "deny"
    }
  },
  "agent": {
    "spsa": {
      "description": "Senior Principal Software Architect. Architectural review, interface contract decisions, security boundary assessment, ADR evaluation, final approval of SPBED output.",
      "mode": "subagent",
      "prompt": "{file:.opencode/agent/spsa.md}",
      "bash": {
        "*": "allow"
      }
    },
    "spbed": {
      "description": "Senior Principal Back-End Developer. Implements features, adapters, refactors, tests within contract boundaries.",
      "mode": "subagent",
      "prompt": "{file:.opencode/agent/spbed.md}",
      "permission": {
        "bash": {
          "*": "allow"
        },
        "write": "allow",
        "edit": {
          "*": "allow",
          "packages/core/src/interfaces.ts": "deny",
          ".opencode/skill/constraints/**": "deny",
          ".opencode/skill/security/**": "deny",
          ".opencode/skill/principles/**": "deny",
          ".opencode/agent/*.md": "deny",
          "DECISION-LOG.md": "deny"
        },
        "skill": { "git-workflow": "allow" }
      }
    },
    "spqae": {
      "description": "Senior Principal QA Engineer. Test sufficiency, coverage thresholds, missing scenarios, test structure.",
      "mode": "subagent",
      "prompt": "{file:.opencode/agent/spqae.md}",
      "permission": {
        "bash": {
          "*": "allow"
        },
        "write": "deny",
        "edit": "deny"
      }
    }
  }
}
