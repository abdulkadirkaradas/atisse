          "pnpm changeset publish*": "deny",
          "yarn publish*": "deny",
          "npx changeset publish*": "deny",
          "rm -rf *": "deny",
          "kill -9 *": "deny",
          "kill *": "deny",
          "pkill*": "deny",
          "killall*": "deny",
          "pm2 *": "deny",
          "systemctl *": "deny",
          "gh workflow run*": "deny",
          "gh run*": "deny",
          "gh pr merge*": "ask",
          "gh pr close*": "ask",
          "gh issue close*": "ask",
          "gh pr review *--approve*": "ask",
          "gh pr review -a*": "ask",
          "gh release create*": "ask",
          "gh repo delete*": "deny",
          "gh repo archive*": "deny",
          "gh secret set*": "deny",
          "gh api *-X DELETE*": "deny",
          "gh api *-X PATCH*": "ask",
          "gh api *-X POST*": "ask"
        },
        "write": "allow",
        "edit": {
          "*": "allow",
          "packages/core/src/interfaces.ts": "deny",
          ".opencode/skill/constraints/**": "deny",
          ".opencode/skill/security/**": "deny",
          ".opencode/skill/principles/**": "deny",
          ".opencode/agent/*.md": "deny",
          "DECISION-LOG.md": "deny"
        },
        "skill": {
          "git-workflow": "allow"
        }
      }
    },
    "spqae": {
      "description": "Senior Principal QA Engineer. Test sufficiency, coverage thresholds, missing scenarios, test structure.",
      "mode": "subagent",
      "prompt": "{file:.opencode/agent/spqae.md}",
      "permission": {
        "bash": {
          "*": "allow",
          "git push --force*": "deny",
          "git push -f*": "deny",
          "git push +*": "deny",
          "git push *--force*": "deny",
          "git reset --hard*": "deny",
          "npm publish*": "deny",
          "pnpm publish*": "deny",
          "pnpm changeset publish*": "deny",
          "yarn publish*": "deny",
          "npx changeset publish*": "deny",
          "rm -rf *": "deny",
          "kill -9 *": "deny",
          "kill *": "deny",
          "pkill*": "deny",
          "killall*": "deny",
          "pm2 *": "deny",
          "systemctl *": "deny",
          "gh workflow run*": "deny",
          "gh run*": "deny",
          "gh pr merge*": "ask",
          "gh pr close*": "ask",
          "gh issue close*": "ask",
          "gh pr review *--approve*": "ask",
          "gh pr review -a*": "ask",
          "gh release create*": "ask",
          "gh repo delete*": "deny",
          "gh repo archive*": "deny",
          "gh secret set*": "deny",
          "gh api *-X DELETE*": "deny",
          "gh api *-X PATCH*": "ask",
          "gh api *-X POST*": "ask"
        },
        "write": "deny",
        "edit": "deny"
      }
    }
  }
}
